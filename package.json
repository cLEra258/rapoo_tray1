{
  "name": "rapoo-electron-tray",
  "version": "1.0.0",
  "description": "Rapoo Mouse Battery Tray using WebHID",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
